<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--    LOG_PATH is supplied from logging.files.path by the application. -->

    <!--    INFO级别及以上日志滚动配置-->
    <appender name="ROL-SIZE-FILE-LOG-INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/%d{yyyy-MM-dd}/info-%i.log</fileNamePattern>
            <!--            单个文件的最大大小 -->
            <maxFileSize>10MB</maxFileSize>
            <!--            只保留近30天的日志 -->
            <maxHistory>30</maxHistory>
            <!--            用来指定日志文件的上限大小，那么到了这个值，就会删除旧的日志 -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level --- [%-24thread] %-40.40logger{40} : %msg%n</pattern>
        </encoder>

        <!--        只处理INFO级别以及之上的日志 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>

    </appender>

    <!--    异步INFO及以上日志-->
    <appender name="ASYNC-INFO" class="ch.qos.logback.classic.AsyncAppender">
        <!--        不丢失日志.默认的,如果队列的80%已满,则会丢弃TRACT、DEBUG、INFO级别的日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!--        更改默认的队列的深度,该值会影响性能.默认值为256 -->
        <queueSize>128</queueSize>
        <!--        添加附加的appender,最多只能添加一个 -->
        <appender-ref ref="ROL-SIZE-FILE-LOG-INFO"/>
    </appender>

    <!--    WARN日志滚动配置 -->
    <appender name="ROL-SIZE-FILE-LOG-WARN" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/%d{yyyy-MM-dd}/warn-%i.log</fileNamePattern>
            <!--            单个文件的最大大小 -->
            <maxFileSize>1MB</maxFileSize>
            <!--            只保留近30天的日志 -->
            <maxHistory>30</maxHistory>
            <!--            用来指定日志文件的上限大小，那么到了这个值，就会删除旧的日志 -->
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} --- [%-24thread] %-40.40logger{40} : %msg%n</pattern>
        </encoder>

        <!--        只处理WARN级别的日志 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!--    异步WARN日志-->
    <appender name="ASYNC-WARN" class="ch.qos.logback.classic.AsyncAppender">
        <!--        不丢失日志.默认的,如果队列的80%已满,则会丢弃TRACT、DEBUG、INFO级别的日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!--        更改默认的队列的深度,该值会影响性能.默认值为256 -->
        <queueSize>128</queueSize>
        <!--        添加附加的appender,最多只能添加一个 -->
        <appender-ref ref="ROL-SIZE-FILE-LOG-WARN"/>
    </appender>

    <!--    ERROR日志滚动配置 -->
    <appender name="ROL-SIZE-FILE-LOG-ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/%d{yyyy-MM-dd}/error-%i.log</fileNamePattern>
            <!--            单个文件的最大大小 -->
            <maxFileSize>1MB</maxFileSize>
            <!--            只保留近30天的日志 -->
            <maxHistory>30</maxHistory>
            <!--            用来指定日志文件的上限大小，那么到了这个值，就会删除旧的日志 -->
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} --- [%-24thread] %-40.40logger{40} : %msg%n</pattern>
        </encoder>

        <!--        只处理ERROR级别的日志 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!--   异步ERROR日志-->
    <appender name="ASYNC-ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <!--        不丢失日志.默认的,如果队列的80%已满,则会丢弃TRACT、DEBUG、INFO级别的日志 -->
        <discardingThreshold>0</discardingThreshold>
        <!--        更改默认的队列的深度,该值会影响性能.默认值为256 -->
        <queueSize>128</queueSize>
        <!--        添加附加的appender,最多只能添加一个 -->
        <appender-ref ref="ROL-SIZE-FILE-LOG-ERROR"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="ASYNC-INFO"/>
        <appender-ref ref="ASYNC-WARN"/>
        <appender-ref ref="ASYNC-ERROR"/>
    </root>

</configuration>